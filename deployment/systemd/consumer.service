[Unit]
Description=CS6650 consumer (RabbitMQ -> broadcast)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/cs6650
EnvironmentFile=-/etc/cs6650/consumer.env
ExecStart=/usr/bin/java -jar /opt/cs6650/consumer.jar
Restart=always
RestartSec=2
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target

