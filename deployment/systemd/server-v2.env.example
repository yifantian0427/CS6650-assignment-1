# Copy to /etc/cs6650/server-v2.env on the EC2 instance.
#
# Spring Boot supports environment variables that map to properties:
#   app.queue.host -> APP_QUEUE_HOST
#   app.queue.port -> APP_QUEUE_PORT
#
# NOTE: This file is sourced by systemd EnvironmentFile.

APP_SERVER_ID=server-1

SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

APP_QUEUE_HOST=localhost
APP_QUEUE_PORT=5672
APP_QUEUE_VIRTUAL_HOST=/
APP_QUEUE_USERNAME=guest
APP_QUEUE_PASSWORD=guest
APP_QUEUE_EXCHANGE_NAME=chat.exchange
APP_QUEUE_ROUTING_KEY_PREFIX=room.
APP_QUEUE_NUM_ROOMS=20

# Tuning (set these based on experiments)
APP_QUEUE_POOL_SIZE=10
APP_QUEUE_MESSAGE_TTL_MS=0
APP_QUEUE_MAX_LENGTH=0
APP_QUEUE_MAX_LENGTH_BYTES=0
APP_QUEUE_PUBLISHER_CONFIRMS=true

APP_QUEUE_CIRCUIT_OPEN_THRESHOLD=5
APP_QUEUE_CIRCUIT_RETRY_MS=10000

