# Copy to /etc/cs6650/consumer.env on the EC2 instance.

SERVER_PORT=8081
SERVER_ADDRESS=0.0.0.0

APP_RABBITMQ_HOST=localhost
APP_RABBITMQ_PORT=5672
APP_RABBITMQ_VIRTUAL_HOST=/
APP_RABBITMQ_USERNAME=guest
APP_RABBITMQ_PASSWORD=guest
APP_RABBITMQ_EXCHANGE_NAME=chat.exchange
APP_RABBITMQ_NUM_ROOMS=20

APP_CONSUMER_THREADS=20
APP_CONSUMER_PREFETCH_COUNT=10

APP_DEDUPE_PER_ROOM_CAPACITY=10000

# Comma-separated: http://10.0.1.10:8080,http://10.0.1.11:8080
APP_SERVERS_URLS=http://localhost:8080

