# Copy to params.env and fill in your values.
# Usage: source params.env  (or . params.env) before running create-alb.sh

# AWS
export AWS_REGION=us-east-1

# Network: ALB and targets must be in same VPC
export VPC_ID=vpc-xxxxxxxx
# At least 2 subnets (different AZs) for ALB
export SUBNET_IDS="subnet-aaaaaaaa subnet-bbbbbbbb"
# Security group for ALB: allow inbound 80 (and 443 if HTTPS)
export ALB_SECURITY_GROUP_ID=sg-xxxxxxxx
# Security group for server-v2 instances: allow 8080 from ALB SG, and 22 for SSH
export SERVER_SECURITY_GROUP_ID=sg-yyyyyyyy

# Target group: server-v2 instances (WebSocket servers)
# Fill after creating EC2 instances for server-v2
export SERVER_INSTANCE_IDS="i-11111111 i-22222222"
# Optional: 4 instances for load-balanced test
# export SERVER_INSTANCE_IDS="i-11111111 i-22222222 i-33333333 i-44444444"

# Names (optional; script defaults)
export ALB_NAME=cs6650-chat-alb
export TARGET_GROUP_NAME=cs6650-chat-servers
